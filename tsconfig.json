{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "types": ["vite/client", "vite-svg-loader"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@launcher/*": ["./src/launcher-app/*"],
      "@tauri-apps/api/core": ["./src/launcher-app-mock/core.ts"],
      "@tauri-apps/api/event": ["./src/launcher-app-mock/event.ts"],
      "@tauri-apps/api/app": ["./src/launcher-app-mock/app.ts"],
      "@tauri-apps/api/window": ["./src/launcher-app-mock/window.ts"],
      "@tauri-apps/api/webview": ["./src/launcher-app-mock/webview.ts"],
      "@tauri-apps/plugin-dialog": ["./src/launcher-app-mock/dialog.ts"],
      "@tauri-apps/plugin-fs": ["./src/launcher-app-mock/fs.ts"],
      "@tauri-apps/plugin-http": ["./src/launcher-app-mock/http.ts"],
      "@tauri-apps/plugin-opener": ["./src/launcher-app-mock/opener.ts"],
      "@tauri-apps/plugin-os": ["./src/launcher-app-mock/os.ts"],
      "@tauri-apps/plugin-window-state": ["./src/launcher-app-mock/window-state.ts"],
      "#ui/*": ["./src/vendor/ui/*"],
      "@modrinth/ui": ["./src/vendor/ui/index.ts"],
      "@modrinth/ui/src/*": ["./src/vendor/ui/*"],
      "@modrinth/assets": ["./src/vendor/assets/index.ts"],
      "@modrinth/assets/*": ["./src/vendor/assets/*"],
      "@modrinth/utils": ["./src/vendor/utils/index.ts"],
      "@modrinth/utils/*": ["./src/vendor/utils/*"],
      "@modrinth/api-client": ["./src/vendor/api-client/index.ts"],
      "@modrinth/blog/changelog": ["./src/vendor/blog/changelog.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
